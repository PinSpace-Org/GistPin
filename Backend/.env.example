# App
PORT=3000
NODE_ENV=development

# Database — defaults match docker-compose.yml
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=gistpin
DATABASE_PASSWORD=gistpin
DATABASE_NAME=gistpin
# Connection pool size (defaults: max 10, min 2)
DB_POOL_MAX=10
DB_POOL_MIN=2

# Soroban / Stellar
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Set to the deployed GistRegistry contract to enable live mode.
# Leave blank to run in mock mode (no blockchain calls).
CONTRACT_ID_GIST_REGISTRY=
# Retries for Soroban RPC calls (default 3)
SOROBAN_RETRY_ATTEMPTS=3
# Optional: Stellar public key (G...) reported as the moderator/admin in mock mode
# MODERATOR_ADDRESS=

# IPFS (Pinata) — leave blank to use mock CIDs in dev
PINATA_API_KEY=
PINATA_SECRET_KEY=
IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
# Retries for IPFS pin/fetch calls (default 3)
IPFS_RETRY_ATTEMPTS=3

# Optional: backend signing keypair for submitting txs to Soroban
STELLAR_SECRET_KEY=

# HTTP
# Comma-separated allowed CORS origins (default http://localhost:3001,http://localhost:8081)
CORS_ORIGINS=http://localhost:3001,http://localhost:8081
# Rate limiting: requests allowed per window (default 10) and window in ms (default 60000)
THROTTLE_LIMIT=10
THROTTLE_TTL_MS=60000
# Milliseconds to drain in-flight requests on shutdown (default 25000)
SHUTDOWN_TIMEOUT_MS=25000

# Stats endpoint cache TTL in ms (default 30000)
STATS_CACHE_TTL_MS=30000

# Logging — directory for rotated log files (production only)
LOG_DIR=logs
